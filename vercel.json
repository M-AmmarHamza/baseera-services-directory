{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api/:match*" },
    { "source": "/:lang/:country/:city/:category/:slug", "destination": "/provider-profile.html?lang=:lang&country=:country&city=:city&category=:category&slug=:slug" },
    { "source": "/:lang/:country/:city/:category", "destination": "/categories.html?lang=:lang&country=:country&city=:city&category=:category" },
    { "source": "/:country/:city", "destination": "/index.html?country=:country&city=:city" }
  ]
}
