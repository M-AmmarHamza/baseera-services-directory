# Baseera Environment Variables Template
# Copy this file to .env.local and update with your environment values

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Dynamic Base URL for Technical SEO & Domain Migration
# Example: https://baseera.com or https://baseera-services-directory.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Staging Indexing Protection Guard
# Set to 'false' while on staging/temp domain to prevent duplicate content indexing
# Set to 'true' once the official production custom domain is pointed and live
NEXT_PUBLIC_ALLOW_INDEXING=false

# Google AdSense / Third-Party Ad Network
# Publisher Client ID (e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your-publisher-id

# Admin Authentication
ADMIN_SECRET_KEY=your-admin-secret-key-min-32-chars
ADMIN_EMAIL=admin@baseera.com
ADMIN_PASSWORD=your-secure-admin-password
