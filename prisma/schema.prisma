// =========================================================================
// BASEERA DIRECTORY - PRISMA SCHEMA (POSTGRESQL / SUPABASE)
// Lead Generation Directory Platform
// =========================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  MODERATOR
  PROVIDER
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  role      UserRole   @default(PROVIDER)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  adminEmail String?  @map("admin_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ProviderStatus {
  pending
  published
  suspended
  approved
  rejected
}

enum ProfileRole {
  customer
  provider
  admin
}

enum FaqScope {
  GLOBAL
  CATEGORY
}

model Country {
  id           Int        @id @default(autoincrement())
  name         String
  name_en      String?    @map("name_en")
  name_ur      String?    @map("name_ur")
  code         String     @unique
  slug         String     @unique
  currency     String?    @default("PKR")
  premiumPrice Int?       @default(2500) @map("premium_price")
  isActive     Boolean?   @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  cities       City[]
  providers    Provider[]

  @@map("countries")
}

model City {
  id          Int        @id @default(autoincrement())
  countryId   Int        @map("country_id")
  name        String
  name_en     String?    @map("name_en")
  name_ur     String?    @map("name_ur")
  slug        String
  targetAreas String[]   @default([]) @map("target_areas")
  isActive    Boolean?   @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  country     Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  providers   Provider[]

  @@unique([countryId, slug])
  @@map("cities")
}

model Category {
  id           String                @id
  name         String
  name_en      String?               @map("name_en")
  name_ur      String?               @map("name_ur")
  slug         String                @unique
  slug_en      String?               @unique @map("slug_en")
  slug_ur      String?               @unique @map("slug_ur")
  icon         String                @default("Wrench")
  sortOrder    Int                   @default(0) @map("sort_order")
  isActive     Boolean?              @default(true) @map("is_active")
  activeCount  Int?                  @default(0) @map("active_count")
  intro_en     String?               @map("intro_en")
  intro_ur     String?               @map("intro_ur")
  intro_ar     String?               @map("intro_ar")
  faqs_en      Json?                 @map("faqs_en")
  faqs_ur      Json?                 @map("faqs_ur")
  faqs_ar      Json?                 @map("faqs_ar")
  createdAt    DateTime              @default(now()) @map("created_at")
  translations CategoryTranslation[]
  providers    Provider[]
  faqs         Faq[]

  @@map("categories")
}

model Faq {
  id          String    @id @default(uuid())
  scope       FaqScope  @default(GLOBAL)
  categoryId  String?   @map("category_id")
  question_en String    @map("question_en")
  answer_en   String    @map("answer_en")
  question_ur String?   @map("question_ur")
  answer_ur   String?   @map("answer_ur")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([categoryId])
  @@index([sortOrder])
  @@map("faqs")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  categoryId  String   @map("category_id")
  lang        String
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
  @@map("category_translations")
}

model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String   @map("full_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  role      String   @default("customer")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Provider {
  id              String   @id @default(uuid())
  publicId        Int      @unique @default(autoincrement())
  userId          String?  @map("user_id")
  countryId       Int?     @default(1) @map("country_id")
  cityId          Int?     @default(1) @map("city_id")
  categoryId      String?  @map("category_id")
  name            String
  slug            String   @unique
  profileType     String   @default("individual") @map("profile_type")
  whatsappNumber  String   @map("whatsapp_number")
  phoneNumber     String?  @map("phone_number")
  serviceArea     String[] @default([]) @map("service_area")
  targetAreas     String[] @default([]) @map("target_areas")
  shortBio        String?  @map("short_bio")
  bio             String?
  status          String   @default("pending")
  seoIndex        Boolean? @default(false) @map("seo_index")
  isVerified      Boolean? @default(false) @map("is_verified")
  isFeatured      Boolean? @default(false) @map("is_featured")
  isAvailable     Boolean? @default(true) @map("is_available")
  isPremium       Boolean? @default(false) @map("is_premium")
  avatarUrl       String?  @map("avatar_url")
  profilePicture  String?  @map("profile_picture")
  portfolioPhotos String[] @default([]) @map("portfolio_photos")
  galleryImages   String[] @default([]) @map("gallery_images")
  googleMapUrl    String?  @map("google_map_url")
  certificates    String[] @default([])
  startingPrice   Int?     @default(500) @map("starting_price")
  rating          Decimal? @default(5.0) @db.Decimal(3, 1)
  reviewCount     Int?     @default(0) @map("review_count")
  totalLeads      Int?     @default(0) @map("total_leads")
  profileViews    Int?     @default(0) @map("profile_views")
  whatsappClicks  Int?     @default(0) @map("whatsapp_clicks")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  country  Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  city     City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([seoIndex])
  @@index([isFeatured])
  @@index([isVerified])
  @@map("providers")
}

model RedirectRule {
  id              String   @id @default(uuid())
  sourcePath      String   @unique @map("source_path")
  destinationPath String   @map("destination_path")
  statusCode      Int      @default(301) @map("status_code")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([sourcePath])
  @@index([isActive])
  @@map("redirect_rules")
}

model SiteSetting {
  key       String   @id @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

